# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Bind inside the container; nginx on the host is the only thing in front of it.
HOST=0.0.0.0
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000
# On SIGTERM, keep serving for this long while /ready already answers 503, so
# nginx drains us instead of hitting a refused connection. 0 disables the wait.
SHUTDOWN_DRAIN_MS=3000

# ---------------------------------------------------------------------------
# Auth — checked against the X-API-Key header. Comma-separated, min 16 chars.
# Generate with: openssl rand -hex 24
# ---------------------------------------------------------------------------
API_KEYS=replace-me-with-a-long-random-key
AUTH_ENABLED=true

# ---------------------------------------------------------------------------
# Model & thresholds
# MODEL_PATH is baked into the image at build time; nothing is downloaded at
# runtime. nsfwScore = porn + hentai + (sexy * SEXY_WEIGHT)
# ---------------------------------------------------------------------------
MODEL_PATH=/app/model
THRESHOLD_BLOCK=0.7
THRESHOLD_REVIEW=0.4
SEXY_WEIGHT=0.5

# ---------------------------------------------------------------------------
# Input limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=50000000
MAX_BATCH_SIZE=10
# MIME is detected from magic bytes, never from the filename or Content-Type.
ALLOWED_MIME=image/jpeg,image/png,image/webp,image/gif,image/bmp,image/avif

# ---------------------------------------------------------------------------
# Remote fetch for {"url": "..."} requests
# URL_ALLOWLIST: bare hostnames, comma-separated. Empty = allow any public host.
# ---------------------------------------------------------------------------
URL_FETCH_ENABLED=true
URL_FETCH_TIMEOUT_MS=8000
URL_ALLOWLIST=

# ---------------------------------------------------------------------------
# Inference pool
# ---------------------------------------------------------------------------
WORKER_POOL_SIZE=2
INFERENCE_TIMEOUT_MS=15000
MAX_CONCURRENT_REQUESTS=20

# ---------------------------------------------------------------------------
# Rate limiting (per API key, in-process)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Observability & privacy
# STORE_IMAGE_HASH controls the SHA-256 in the response. Image bytes are never
# written to disk regardless of this setting.
# ---------------------------------------------------------------------------
METRICS_ENABLED=true
STORE_IMAGE_HASH=true

# ---------------------------------------------------------------------------
# Optional result cache, keyed by image SHA-256
# ---------------------------------------------------------------------------
CACHE_ENABLED=false
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Optional TF.js CPU tuning. 0 = let libtensorflow decide (one pool per worker,
# sized to all cores). On a shared box set these so WORKER_POOL_SIZE workers do
# not fight each other and the other containers for CPU.
# ---------------------------------------------------------------------------
TF_NUM_INTRAOP_THREADS=2
TF_NUM_INTEROP_THREADS=1
