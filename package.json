  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "bake:model": "node scripts/bake-model.js",
    "fixtures": "node test/fixtures/generate.js",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:pool": "node test/pool-resilience.js",
    "test:leak": "node test/memory-leak.js 1000",
    "test:all": "npm run test && npm run test:pool && npm run test:leak",
    "verify:runtime": "node scripts/verify-step1.js"
