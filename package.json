    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "nsfwjs": "^4.3.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": ">=22.0.0 <23"
